# ---- Tebex (payments). Tebex control panel -> Integrations -> Headless API -> Public token
TEBEX_PUBLIC_TOKEN=
# Optional but recommended: Headless API private key (lets Tebex use the buyer's IP for tax/fraud checks)
TEBEX_PRIVATE_KEY=
# Optional: link site products to Tebex packages when the names don't match, e.g.
# TEBEX_PACKAGE_MAP={"10-coins":1234567,"25-coins":1234568}
TEBEX_PACKAGE_MAP=

# ---- Optional: store database, only used to show a player's coin balance on the checkout page
# (run db/pmv2_store.sql on the same MySQL/MariaDB your FiveM server uses)
# Either DATABASE_URL=mysql://user:pass@host:3306/dbname  or the separate values below.
DATABASE_URL=
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false

# ---- Optional: "Log in with Discord" on the checkout page to see the coin balance (Discord Developer Portal -> your app -> OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://projectmisfitsrp.com/api/auth/discord/callback
# Long random string (32+ characters) used to sign the login cookie
CUSTOMER_SESSION_SECRET=
